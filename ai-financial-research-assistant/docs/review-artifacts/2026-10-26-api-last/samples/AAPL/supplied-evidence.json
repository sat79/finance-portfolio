    "E7:B6": {
      "url": "https://www.sec.gov/Archives/edgar/data/320193/000032019326000018/a8-kex991q3202606272026.htm",
      "locator": "HTML text block 6",
      "sha256": "a5a4b31d9e35897d05b424aee3cf77ad1799abc61e317f93211f8fdaa2aa0281",
