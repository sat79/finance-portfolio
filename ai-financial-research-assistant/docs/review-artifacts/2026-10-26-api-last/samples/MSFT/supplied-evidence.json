    "E5:B4": {
      "url": "https://www.sec.gov/Archives/edgar/data/789019/000119312526323632/msft-ex99_1.htm",
      "locator": "HTML text block 4",
      "sha256": "5d7e2f77e7af504e18c2fcbcb981c34442a9570bc0d49cb06ac40f110e285052",
      "kind": "disclosure excerpt",
      "document_id": "E5",
